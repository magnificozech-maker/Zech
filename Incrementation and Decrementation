!DOCTYPE html>

<title>Counter</title>

<h1>Counter: <span id="count">0</span></h1>

<button onclick="increment()">+</button>
<button onclick="decrement()">-</button>

<script>
    let count = 0;

    function increment() {
        count++;
        document.getElementById("count").textContent = count;
    }

    function decrement() {
        count--;
        document.getElementById("count").textContent = count;
    }
</script>
